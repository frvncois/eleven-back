{
  "kind": "collectionType",
  "collectionName": "people",
  "info": {
    "singularName": "person",
    "pluralName": "people",
    "displayName": "Team",
    "description": "The Eleven team; mixers are the six with isMixer."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "slug": {
      "type": "uid"
    },
    "name": {
      "type": "string",
      "required": true
    },
    "role": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "instagram": {
      "type": "string"
    },
    "linkedin": {
      "type": "string"
    },
    "isMixer": {
      "type": "boolean",
      "default": false
    },
    "order": {
      "type": "integer",
      "required": true
    },
    "photo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "icon": {
      "type": "component",
      "repeatable": false,
      "component": "people.icon"
    },
    "teamBar": {
      "type": "component",
      "repeatable": false,
      "component": "people.team-bar",
      "required": true
    },
    "projects": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::project.project",
      "mappedBy": "mixer"
    }
  }
}
